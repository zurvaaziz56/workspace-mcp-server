{
  "name": "workspace-mcp-server",
  "version": "2.0.0",
  "description": "Read-only multi-root MCP server exposing your workspaces (projects, daily logs, files, cross-workspace search) to any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "workspace-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
